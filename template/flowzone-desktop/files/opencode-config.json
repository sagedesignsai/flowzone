{
  "provider": {
    "anthropic": {
      "model": "claude-sonnet-4-20250514",
      "apiKey": "${ANTHROPIC_API_KEY}"
    },
    "openai": {
      "model": "gpt-4o",
      "apiKey": "${OPENAI_API_KEY}"
    },
    "fallback": true
  },
  "permissions": {
    "file": {
      "read": ["**/*"],
      "write": ["**/*.{ts,tsx,js,jsx,css,md,json,yaml,yml,html,prisma,env}"],
      "deny": [".env", ".env.*", "**/node_modules/**", "**/.git/**"]
    },
    "command": {
      "allow": ["pnpm", "npm", "npx", "git", "ls", "cat", "mkdir", "rm", "cp", "mv"],
      "deny": ["sudo", "rm -rf /", "chmod 777"]
    }
  },
  "agent": {
    "name": "flowzone-desktop",
    "working_directory": "/home/user/project",
    "max_iterations": 50
  }
}
