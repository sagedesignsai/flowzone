{
  "provider": {
    "providers": [],
    "fallback": true
  },
  "permissions": {
    "file": {
      "read": ["**/*"],
      "write": ["**/*"],
      "deny": []
    },
    "command": {
      "allow": ["pnpm", "npm", "npx", "git", "ls", "cat", "mkdir", "rm", "cp", "mv", "python3", "go", "cargo", "rustc", "gh", "code", "jq", "rg", "fzf", "curl", "wget", "tar", "gzip", "make"],
      "deny": ["sudo.*", "rm -rf /", "chmod 777.*"]
    }
  },
  "agent": {
    "name": "flowzone-desktop-dev",
    "working_directory": "/home/user/project",
    "max_iterations": 50
  },
  "autoupdate": "notify",
  "telemetry": "off"
}
