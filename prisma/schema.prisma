generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// BetterAuth: User model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Total credits available (purchased + bonuses - usage)
  credits Int @default(0)

  sessions            Session[]
  accounts            Account[]
  projects            Project[]
  chats               Chat[]
  posts               Post[]
  creditTransactions  CreditTransaction[]
  desktopRuns         DesktopRun[]
}

/// BetterAuth: Session model
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// BetterAuth: Account model
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// BetterAuth: Verification model
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

/// Flowzone: A project containing chats and configuration
model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  envVars   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats    Chat[]
  gitRepos GitRepo[]

  @@index([userId])
}

/// Flowzone: A chat conversation with the AI agent
model Chat {
  id        String    @id @default(cuid())
  title     String
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  gitRepoId String?
  gitRepo   GitRepo?  @relation(fields: [gitRepoId], references: [id], onDelete: SetNull)
  gitBranch String?   /// The working branch created for this chat (e.g. "flowzone/abc123")

  /// When true, the user chose chat-only mode (no desktop sandbox attachment).
  desktopOptOut Boolean @default(false)

  /// Environment the chat was started in: "code" | "desktop" | "opencode"
  environment String @default("code")

  messages    Message[]
  sandboxRun  SandboxRun?
  desktopRun  DesktopRun?
  agentRun    AgentRun?

  @@index([projectId])
  @@index([userId])
  @@index([gitRepoId])
}

/// Flowzone: A GitHub repository imported into the platform
model GitRepo {
  id              String   @id @default(cuid())
  owner           String
  name            String
  fullName        String   @unique /// "owner/name"
  defaultBranch   String   @default("main")
  isPrivate       Boolean  @default(false)
  isFork          Boolean  @default(false)
  description     String?
  language        String?
  installationId  String?  /// GitHub App installation ID for private repo access
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chats Chat[]

  @@index([fullName])
  @@index([projectId])
}

/// Flowzone: A single message in a chat
model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "tool"
  content   String
  parts     Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

/// Flowzone: An E2B sandbox tied to a chat
model SandboxRun {
  id           String   @id @default(cuid())
  chatId       String   @unique
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  e2bSandboxId String   @unique
  templateId   String   @default("base")
  status       String   @default("creating") // creating | running | paused | stopped
  previewUrl   String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  repoPath    String?  /// Path inside sandbox where repo is cloned
  gitBranch   String?  /// Branch checked out in sandbox

  @@index([e2bSandboxId])
  @@index([status])
}

/// Flowzone: E2B desktop (VNC) sandbox tied to a chat
model DesktopRun {
  id           String   @id @default(cuid())
  chatId       String   @unique
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  e2bSandboxId String   @unique
  status       String   @default("running") // creating | running | stopped
  ptyPid       Int?     /// PID of the persistent PTY session
  tmuxSession  String?  @default("flowzone-core") /// Shared tmux session name
  createdAt    DateTime @default(now())
  expiresAt    DateTime?

  @@index([userId])
  @@index([e2bSandboxId])
  @@index([status])
}

/// Flowzone: A GitHub webhook event log
model WebhookEvent {
  id             String   @id @default(cuid())
  eventType      String
  action         String?
  payload        Json     @default("{}")
  installationId String?
  gitRepoId      String?
  processed      Boolean  @default(false)
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([eventType])
  @@index([installationId])
  @@index([createdAt])
}

/// Flowzone: A Trigger.dev durable agent execution
model AgentRun {
  id           String    @id @default(cuid())
  chatId       String    @unique
  chat         Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  status       String    @default("pending") // pending | running | completed | failed
  triggerRunId String?
  steps        Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status])
}

/// Quickstart: A blog post
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

/// Flowzone: A predefined credit purchase plan
model PricingPlan {
  id          String   @id @default(cuid())
  name        String   /// e.g. "Starter", "Pro", "Premium"
  credits     Int      /// Number of credits included
  priceZar    Int      /// Price in ZAR cents (for PayFast - South Africa)
  priceUsd    Int      /// Price in USD cents (for Polar.sh - International)
  description String?
  badge       String?  /// e.g. "Popular", "Best value"
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Flowzone: A credit transaction (purchase, usage, refund, bonus)
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "purchase" | "usage" | "refund" | "bonus" | "expired"
  type         String
  /// Positive for credits received, negative for credits spent
  amount       Int
  /// Running balance after this transaction
  balanceAfter Int
  /// Human-readable description
  description  String?

  /// Payment provider details
  provider     String?  /// "payfast" | "polar"
  providerTxId String?  /// PayFast pf_payment_id or Polar order/checkout ID
  status       String?  /// "completed" | "pending" | "failed"

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([provider, providerTxId])
  @@index([createdAt])
}
